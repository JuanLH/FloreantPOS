<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.floreantpos.model">
  <class lazy="false" name="com.floreantpos.model.Ingredient" table="INGREDIENT">
    <id column="ID" name="id" type="java.lang.Integer">
      <generator class="identity"/>
    </id>
    <property column="NAME" length="120" name="name" not-null="true" type="string"/>
    <property column="DESCRIPTION" length="255" name="description" type="string"/>
  </class>
</hibernate-mapping>
