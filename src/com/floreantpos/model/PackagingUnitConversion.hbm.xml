<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.floreantpos.model">
  <class lazy="false" name="com.floreantpos.model.PackagingUnitConversion" table="PACKAGING_UNIT_CONVERSION">
    <id column="ID" name="id" type="java.lang.Integer">
      <generator class="identity"/>
    </id>
    <many-to-one class="com.floreantpos.model.PackagingUnit" column="SOURCE_UNIT_ID" lazy="false" name="sourceUnit" not-null="true"/>
    <many-to-one class="com.floreantpos.model.PackagingUnit" column="TARGET_UNIT_ID" lazy="false" name="targetUnit" not-null="true"/>
    <property column="CONVERSION_FACTOR" name="factor" type="java.lang.Double" not-null="true"/>
    <property column="ACTIVE" name="active" type="java.lang.Boolean" not-null="true"/>
  </class>
</hibernate-mapping>
