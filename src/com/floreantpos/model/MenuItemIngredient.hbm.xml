<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.floreantpos.model">
  <class lazy="false" name="com.floreantpos.model.MenuItemIngredient" table="MENUITEM_INGREDIENT">
    <id column="ID" name="id" type="java.lang.Integer">
      <generator class="identity"/>
    </id>
    
    <property column="CAN_BE_REMOVED" name="canBeRemoved" type="java.lang.Boolean"/>
    <property column="IS_ADDED_BY_DEFAULT" name="isAddedByDefault" type="java.lang.Boolean"/>
    <many-to-one class="com.floreantpos.model.Ingredient" column="INGREDIENT_ID" lazy="false" name="ingredient"/>
    <many-to-one class="com.floreantpos.model.MenuItem" column="MENUITEM_ID" lazy="false" name="menuItem"/>
  </class>
</hibernate-mapping>
